{
  "manifest_version": 3,
  "name": "DeepSeek Code Manager",
  "version": "1.4.3",
  "description": "Collapse DeepSeek code blocks, jump to them from popup, and apply structured Code Change Packages.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepSeek Code Manager"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "ccp.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
